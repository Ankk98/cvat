    },
    "annotations": {
      "name": "SAM Auto Segmentation",
      "spec": "[{\"name\": \"object\", \"type\": \"mask\", \"attributes\": [{\"name\": \"confidence\", \"input_type\": \"number\", \"values\": [0, 1]}, {\"name\": \"area\", \"input_type\": \"number\"}]}]",
      "type": "detector",
      "version": "2",
      "description": "Automatic object segmentation using Segment Anything Model"
    }
  },
  "spec": {
    "description": "Interactive object segmentation with Segment-Anything on ROCm GPUs",
    "handler": "main_detector:handler",
    "runtime": "python:3.10",
    "env": [
      {
        "name": "PYTHONPATH",
        "value": "/opt/nuclio/sam"
      },
      {
        "name": "CVAT_FUNCTIONS_REDIS_HOST",
        "value": "cvat_redis_ondisk"
      },
      {
        "name": "CVAT_FUNCTIONS_REDIS_PORT",
        "value": "6666"
      }
    ],
    "resources": {
      "requests": {
        "cpu": "25m",
        "memory": "1Mi"
      }
    },
    "image": "cvat.pth.facebookresearch.sam.vit_h:latest-rocm",
    "targetCPU": 75,
    "triggers": {
      "myHttpTrigger": {
        "class": "",
        "kind": "http",
        "name": "myHttpTrigger",
        "numWorkers": 1,
        "workerAvailabilityTimeoutMilliseconds": 10000,
        "attributes": {
          "maxRequestBodySize": 33554432
        },
        "mode": "sync"
      }
    },
    "build": {
      "image": "cvat.pth.facebookresearch.sam.vit_h:latest-rocm",
      "baseImage": "docker.io/rocm/pytorch:rocm7.1_ubuntu22.04_py3.10_pytorch_release_2.6.0",
      "directives": {
        "preCopy": [
          {
            "kind": "ENV",
            "value": "DEBIAN_FRONTEND=noninteractive"
          },
          {
            "kind": "WORKDIR",
            "value": "/opt/nuclio/sam"
          },
          {
            "kind": "RUN",
            "value": "apt-get update && apt-get install -y git python3 python3-pip ffmpeg libsm6 libxext6 && rm -rf /var/lib/apt/lists/*"
          },
          {
            "kind": "RUN",
            "value": "pip3 install --upgrade pip"
          },
          {
            "kind": "RUN",
            "value": "pip3 install pycocotools matplotlib onnxruntime-gpu onnx"
          },
          {
            "kind": "RUN",
            "value": "pip3 install git+https://github.com/facebookresearch/segment-anything.git"
          },
          {
            "kind": "RUN",
            "value": "curl -O https://dl.fbaipublicfiles.com/segment_anything/sam_vit_h_4b8939.pth"
          }
        ]
      },
      "codeEntryType": "image",
      "timestamp": 1766869815
    },
    "platform": {
      "attributes": {
        "mountMode": "volume",
        "network": "cvat_cvat",
        "restartPolicy": {
          "maximumRetryCount": 3,
          "name": "always"
        }
      }
    },
    "readinessTimeoutSeconds": 120,
    "securityContext": {},
    "disableDefaultHTTPTrigger": false,
